rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function role() {
      return hasProfile()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', null)
        : request.auth.token.get('role', null);
    }

    function legacyAdmin() {
      return signedIn()
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email))
        && get(/databases/$(database)/documents/admins/$(request.auth.token.email))
          .data.get('accessStatus', 'active') == 'active';
    }

    function admin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && ((hasProfile()
            && role() == 'admin'
            && get(/databases/$(database)/documents/users/$(request.auth.uid))
              .data.get('accessStatus', 'active') == 'active')
          || legacyAdmin());
    }

    function staffAccessAllowed() {
      return role() == 'staff'
        && request.auth.token.email_verified == true
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.get('accessStatus', 'active') in ['active', 'invited'];
    }

    function staff() {
      return signedIn() && (admin() || staffAccessAllowed());
    }

    function customer() {
      return signedIn() && role() == 'customer';
    }

    function customerAccessAllowed() {
      return customer()
        && request.auth.token.email_verified == true
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.get('accessStatus', 'invited') in ['active', 'invited'];
    }

    function customerId() {
      return hasProfile()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('customerId', '')
        : request.auth.token.get('customerId', '');
    }

    function customerActivatingUser(userId) {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.uid == userId
        && resource.data.role == 'customer'
        && resource.data.get('accessStatus', 'invited') == 'invited'
        && request.resource.data.accessStatus == 'active'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['accessStatus', 'activatedAt', 'updatedAt'])
        && getAfter(/databases/$(database)/documents/tenants/$(resource.data.customerId))
          .data.accessStatus == 'active';
    }

    function staffActivatingUser(userId) {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.uid == userId
        && resource.data.role == 'staff'
        && resource.data.accessStatus == 'invited'
        && request.resource.data.accessStatus == 'active'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['accessStatus', 'activatedAt', 'updatedAt']);
    }

    function staffRevokingCustomerUser() {
      return staffAccessAllowed()
        && resource.data.role == 'customer'
        && request.resource.data.role == 'customer'
        && request.resource.data.accessStatus == 'revoked'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['accessStatus', 'revokedAt', 'updatedAt'])
        && getAfter(/databases/$(database)/documents/tenants/$(resource.data.customerId))
          .data.status == 'cancelled';
    }

    function customerActivatingTenant(tenantId) {
      return customer()
        && tenantId == customerId()
        && resource.data.get('accessStatus', 'invited') == 'invited'
        && request.resource.data.accessStatus == 'active'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['accessStatus', 'activatedAt', 'updatedAt'])
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.accessStatus == 'active';
    }

    function staffUpdatingTenantAccess() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return staffAccessAllowed()
        && validTenantStatusTransition(changed)
        && !changed.hasAny(['invitedAt', 'invitedBy', 'userId'])
        && (!changed.hasAny(['accessStatus'])
          || (request.resource.data.accessStatus == 'revoked'
            && request.resource.data.status == 'cancelled'
            && getAfter(/databases/$(database)/documents/users/$(resource.data.userId))
              .data.accessStatus == 'revoked'));
    }

    function validTenantStatus(status) {
      return status in ['active', 'booked', 'cancelled', 'checked in', 'checked out', 'inactive', 'occupied'];
    }

    function optionalString(data, key, maximum) {
      let value = data.get(key, '');
      return value is string && value.size() <= maximum;
    }

    function optionalImage(data, key, maximum) {
      let value = data.get(key, null);
      return value == null || (value is string && value.size() <= maximum);
    }

    function validMonth(value) {
      return value is string && value.matches('^[0-9]{4}-(0[1-9]|1[0-2])$');
    }

    function validTenantDocument(data) {
      return data.get('businessType', 'pg') in ['hotel', 'library', 'pg']
        && validTenantStatus(data.status)
        && optionalString(data, 'name', 120)
        && optionalString(data, 'fullName', 120)
        && optionalString(data, 'email', 254)
        && optionalString(data, 'phone', 20)
        && optionalString(data, 'room', 80)
        && data.get('rent', 0) is number
        && data.get('rent', 0) >= 0
        && data.get('rent', 0) <= 10000000
        && optionalImage(data, 'customerPhoto', 260000)
        && optionalImage(data, 'idProof', 260000)
        && optionalImage(data, 'idProofBack', 260000)
        && data.get('services', []) is list
        && data.get('services', []).size() <= 30;
    }

    function validPaymentCreate() {
      return request.resource.data.keys().hasOnly([
          'amountPaid', 'balance', 'businessType', 'createdAt', 'createdBy', 'month',
          'note', 'paidOn', 'status', 'tenantId', 'tenantName', 'tenantRoom', 'totalRent'
        ])
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'Recorded'
        && request.resource.data.businessType in ['hotel', 'library', 'pg']
        && validMonth(request.resource.data.month)
        && optionalString(request.resource.data, 'note', 1000)
        && optionalString(request.resource.data, 'paidOn', 30)
        && optionalString(request.resource.data, 'tenantName', 120)
        && optionalString(request.resource.data, 'tenantRoom', 80)
        && request.resource.data.amountPaid <= 10000000
        && request.resource.data.totalRent is number
        && request.resource.data.totalRent >= request.resource.data.amountPaid
        && request.resource.data.totalRent <= 10000000
        && request.resource.data.balance is number
        && request.resource.data.balance >= 0
        && request.resource.data.balance <= request.resource.data.totalRent;
    }

    function validExpenseCreate() {
      return request.resource.data.keys().hasOnly([
          'amount', 'category', 'createdAt', 'createdBy', 'date', 'note', 'paymentMode', 'title'
        ])
        && request.resource.data.createdAt == request.time
        && request.resource.data.amount <= 10000000
        && optionalString(request.resource.data, 'category', 80)
        && optionalString(request.resource.data, 'date', 30)
        && optionalString(request.resource.data, 'note', 1000)
        && optionalString(request.resource.data, 'paymentMode', 80)
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 160;
    }

    function validInvoiceCreate(invoiceId) {
      return request.resource.data.keys().hasOnly([
          'baseAmount', 'businessType', 'issuedAt', 'issuedBy', 'meterAmount', 'month',
          'status', 'tenantId', 'tenantName', 'tenantRoom', 'total'
        ])
        && invoiceId == request.resource.data.tenantId + '_' + request.resource.data.month
        && request.resource.data.issuedAt == request.time
        && request.resource.data.issuedBy == request.auth.uid
        && request.resource.data.status == 'Issued'
        && request.resource.data.businessType in ['hotel', 'library', 'pg']
        && validMonth(request.resource.data.month)
        && optionalString(request.resource.data, 'tenantName', 120)
        && optionalString(request.resource.data, 'tenantRoom', 80)
        && request.resource.data.baseAmount is number
        && request.resource.data.baseAmount >= 0
        && request.resource.data.meterAmount is number
        && request.resource.data.meterAmount >= 0
        && request.resource.data.total is number
        && request.resource.data.total == request.resource.data.baseAmount + request.resource.data.meterAmount
        && request.resource.data.total <= 10000000;
    }

    function validSettlementCreate(settlementId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'depositApplied', 'depositHeld', 'discount', 'extraCharge', 'finalBalance',
          'finalizedAt', 'finalizedBy', 'grossDue', 'ledgerBalance', 'month',
          'paidAtSettlement', 'paymentReceived', 'refundDue', 'refundStatus',
          'status', 'tenantId', 'tenantName'
        ])
        && settlementId == data.tenantId
        && data.finalizedAt == request.time
        && data.finalizedBy == request.auth.uid
        && data.status == 'Final'
        && validMonth(data.month)
        && optionalString(data, 'tenantName', 120)
        && data.ledgerBalance is number && data.ledgerBalance >= 0 && data.ledgerBalance <= 10000000
        && data.depositHeld is number && data.depositHeld >= 0 && data.depositHeld <= 10000000
        && data.discount is number && data.discount >= 0 && data.discount <= 10000000
        && data.extraCharge is number && data.extraCharge >= 0 && data.extraCharge <= 10000000
        && data.grossDue is number && data.grossDue == data.ledgerBalance + data.extraCharge - data.discount
        && data.grossDue >= 0 && data.grossDue <= 10000000
        && data.depositApplied is number && data.depositApplied >= 0 && data.depositApplied <= data.depositHeld
        && data.refundDue is number && data.refundDue >= 0
        && data.depositApplied + data.refundDue == data.depositHeld
        && data.paymentReceived is number && data.paymentReceived >= 0
        && data.paymentReceived <= data.grossDue - data.depositApplied
        && data.finalBalance is number
        && data.finalBalance == data.grossDue - data.depositApplied - data.paymentReceived
        && data.paidAtSettlement is number && data.paidAtSettlement >= data.paymentReceived
        && ((data.refundDue > 0 && data.refundStatus == 'Due')
          || (data.refundDue == 0 && data.refundStatus == 'None'));
    }

    function validMeterReadingCreate() {
      return request.resource.data.createdAt == request.time
        && request.resource.data.currentReading <= 1000000000
        && (!request.resource.data.keys().hasAny(['month']) || validMonth(request.resource.data.month))
        && optionalString(request.resource.data, 'note', 1000)
        && optionalString(request.resource.data, 'ocrText', 5000)
        && optionalString(request.resource.data, 'tenantName', 120)
        && optionalString(request.resource.data, 'tenantRoom', 80)
        && optionalImage(request.resource.data, 'photo', 700000)
        && request.resource.data.get('photoSize', 0) is number
        && request.resource.data.get('photoSize', 0) >= 0
        && request.resource.data.get('photoSize', 0) <= 700000;
    }

    function validTenantStatusTransition(changed) {
      return !changed.hasAny(['status'])
        || (resource.data.status == 'booked' && request.resource.data.status in ['active', 'cancelled', 'checked in'])
        || (resource.data.status in ['active', 'checked in', 'occupied'] && request.resource.data.status in ['checked out', 'inactive']);
    }

    match /users/{userId} {
      allow read: if admin() || (signedIn() && request.auth.uid == userId);
      allow create, update: if admin()
        && request.resource.data.role in ['admin', 'staff', 'customer'];
      allow update: if customerActivatingUser(userId)
        || staffActivatingUser(userId)
        || staffRevokingCustomerUser();
      allow delete: if admin();
    }

    match /admins/{email} {
      allow read: if admin() || (signedIn() && request.auth.token.email == email);
      allow write: if admin();
    }

    match /tenants/{tenantId} {
      allow read: if staff() || (customerAccessAllowed() && tenantId == customerId());
      allow create: if staff()
        && validTenantDocument(request.resource.data)
        && !request.resource.data.keys().hasAny(['accessStatus', 'invitedAt', 'invitedBy', 'userId']);
      allow update: if (admin() && validTenantDocument(request.resource.data))
        || (staffUpdatingTenantAccess() && validTenantDocument(request.resource.data))
        || customerActivatingTenant(tenantId);
      allow delete: if false;
    }

    match /allocationGuards/{guardId} {
      allow read: if staff();
      allow create, update: if staff()
        && request.resource.data.inventoryType in ['room', 'seat']
        && request.resource.data.reservations is list
        && request.resource.data.reservations.size() <= 100
        && request.resource.data.updatedAt == request.time;
      allow delete: if staff();
    }

    match /payments/{paymentId} {
      allow read: if staff() || (customerAccessAllowed() && resource.data.tenantId == customerId());
      allow create: if staff()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.tenantId is string
        && exists(/databases/$(database)/documents/tenants/$(request.resource.data.tenantId))
        && request.resource.data.amountPaid is number
        && request.resource.data.amountPaid > 0
        && validPaymentCreate()
        && (!exists(/databases/$(database)/documents/settlements/$(request.resource.data.tenantId))
          || (request.resource.data.note == 'Settlement balance'
            && request.resource.data.month == get(/databases/$(database)/documents/settlements/$(request.resource.data.tenantId)).data.month
            && request.resource.data.totalRent == get(/databases/$(database)/documents/settlements/$(request.resource.data.tenantId)).data.grossDue
            && request.resource.data.amountPaid <= get(/databases/$(database)/documents/settlements/$(request.resource.data.tenantId)).data.finalBalance));
      allow update: if staff()
        && !exists(/databases/$(database)/documents/settlements/$(resource.data.tenantId))
        && resource.data.get('status', '') != 'Voided'
        && request.resource.data.status == 'Voided'
        && request.resource.data.voidedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'voidedAt', 'voidedBy']);
      allow delete: if false;
    }

    match /invoices/{invoiceId} {
      allow read: if staff() || (customerAccessAllowed() && resource.data.tenantId == customerId());
      allow create: if staff()
        && request.resource.data.tenantId is string
        && exists(/databases/$(database)/documents/tenants/$(request.resource.data.tenantId))
        && validInvoiceCreate(invoiceId);
      allow update, delete: if false;
    }

    match /settlements/{settlementId} {
      allow read: if staff() || (customerAccessAllowed() && resource.data.tenantId == customerId());
      allow create: if staff()
        && request.resource.data.tenantId is string
        && exists(/databases/$(database)/documents/tenants/$(request.resource.data.tenantId))
        && get(/databases/$(database)/documents/tenants/$(request.resource.data.tenantId)).data.status in ['active', 'checked in', 'occupied']
        && getAfter(/databases/$(database)/documents/tenants/$(request.resource.data.tenantId)).data.status == 'checked out'
        && getAfter(/databases/$(database)/documents/tenants/$(request.resource.data.tenantId)).data.checkedOutAt == request.time
        && validSettlementCreate(settlementId);
      allow update: if staff()
        && resource.data.refundStatus == 'Due'
        && request.resource.data.refundStatus == 'Paid'
        && request.resource.data.refundedBy == request.auth.uid
        && request.resource.data.refundedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['refundStatus', 'refundedAt', 'refundedBy']);
      allow delete: if false;
    }

    match /expenses/{expenseId} {
      allow read: if staff();
      allow create: if staff()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && validExpenseCreate();
      allow update: if staff()
        && resource.data.status != 'Voided'
        && request.resource.data.status == 'Voided'
        && request.resource.data.voidedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'voidedAt', 'voidedBy']);
      allow delete: if false;
    }

    match /meterReadings/{readingId} {
      allow read: if staff() || (customerAccessAllowed() && resource.data.tenantId == customerId());
      allow create: if staff()
        && request.resource.data.tenantId is string
        && exists(/databases/$(database)/documents/tenants/$(request.resource.data.tenantId))
        && request.resource.data.currentReading is number
        && request.resource.data.currentReading >= 0
        && validMeterReadingCreate();
      allow update: if staff()
        && resource.data.get('status', '') != 'Voided'
        && request.resource.data.status == 'Voided'
        && request.resource.data.voidedBy == request.auth.uid
        && request.resource.data.voidedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'voidedAt', 'voidedBy']);
      allow delete: if false;
    }

    match /notices/{noticeId} {
      allow read: if staff()
        || (customerAccessAllowed() && resource.data.audience == 'all')
        || (customerAccessAllowed()
          && resource.data.audience == 'customer'
          && resource.data.tenantId == customerId());
      allow create, update: if staff()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 5000
        && request.resource.data.audience in ['all', 'customer', 'staff']
        && (request.resource.data.audience != 'customer'
          || request.resource.data.tenantId is string);
      allow delete: if staff();
    }

    match /enquiries/{enquiryId} {
      allow read, write: if staff();
    }

    match /supportRequests/{requestId} {
      allow read: if staff()
        || (customerAccessAllowed() && resource.data.customerId == customerId());
      allow create: if customerAccessAllowed()
        && request.resource.data.keys().hasOnly([
          'createdAt', 'createdBy', 'customerId', 'customerName', 'message', 'status', 'type'
        ])
        && request.resource.data.customerId == customerId()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.type in ['issue', 'profile_correction']
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000;
      allow update: if staff()
        && request.resource.data.status in ['open', 'in_progress', 'resolved']
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['response', 'status', 'updatedAt', 'updatedBy'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['response'])
          || (request.resource.data.response is string
            && request.resource.data.response.size() <= 2000))
        && (request.resource.data.status != 'resolved'
          || (request.resource.data.response is string
            && request.resource.data.response.size() > 0
            && request.resource.data.response.size() <= 2000));
      allow delete: if false;
    }

    match /auditEvents/{eventId} {
      allow read: if admin();
      allow create: if staff()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.action is string
        && request.resource.data.action.size() > 0
        && request.resource.data.action.size() <= 80
        && request.resource.data.action in [
          'customer.access_active', 'customer.access_provisioned', 'customer.access_suspended',
          'customer.archived', 'customer.checked_in', 'customer.checked_out',
          'customer.reservation_cancelled', 'expense.created', 'expense.voided',
          'invoices.generated', 'meter.created', 'meter.voided', 'payment.created', 'payment.voided',
          'settlement.finalized', 'settlement.refund_paid',
          'staff.access_active', 'staff.access_revoked', 'staff.access_suspended',
          'staff.invited', 'support_request.in_progress', 'support_request.resolved'
        ]
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
